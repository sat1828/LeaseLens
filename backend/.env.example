# ═══════════════════════════════════════════════════
# LeaseLens Backend — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════

# ── App ──────────────────────────────────────────
APP_NAME=LeaseLens
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING_SEE_COMMAND_ABOVE
FRONTEND_URL=http://localhost:5173

# ── Database (Supabase free tier) ─────────────────
# Get from: supabase.com → project → Settings → Database → URI
# IMPORTANT: asyncpg version uses postgresql+asyncpg:// prefix
# IMPORTANT: sync version (for Alembic) uses postgresql:// prefix
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Anthropic AI (REQUIRED) ───────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# ── Stripe (OPTIONAL — leave blank during dev) ────
# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Get from: dashboard.stripe.com → Products → (create Pro/Team) → price ID
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=

# ── Field encryption (OPTIONAL — auto-generated if blank) ─
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Redis (OPTIONAL — only needed for advanced rate limiting) ─
REDIS_URL=redis://localhost:6379/0

# ── Email (OPTIONAL) ──────────────────────────────
SENDGRID_API_KEY=
FROM_EMAIL=hello@leaselens.in

# ── Limits (don't change unless you know why) ─────
FREE_ANALYSES_PER_MONTH=1
PRO_ANALYSES_PER_MONTH=999999
MAX_PDF_SIZE_MB=25
MAX_PDF_PAGES=100
ENABLE_OCR=true
